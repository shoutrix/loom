# Required
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Semantic Scholar API key (higher rate limits)
LOOM_SEMANTIC_SCHOLAR_API_KEY=

# Optional: Serper API key for Google Scholar search (https://serper.dev)
SERPER_API_KEY=

# Optional: Override model names
LOOM_LLM_PRO_MODEL=gemini-2.5-pro
LOOM_LLM_FLASH_MODEL=gemini-2.0-flash
LOOM_LLM_EMBEDDING_MODEL=gemini-embedding-001

# Optional: Rate limiting
LOOM_RATE_MAX_CALLS_PER_MINUTE=30
LOOM_RATE_MAX_DAILY_LLM_CALLS=2000

# Optional: Vault and data directories
# Root directory where Loom stores all workspace data, vault files, and logs
LOOM_STORAGE_ROOT_DIR=.
LOOM_VAULT_DIR=vault
LOOM_DATA_DIR=data

# Optional: Neo4j (disabled by default)
LOOM_NEO4J_ENABLED=false
LOOM_NEO4J_URI=bolt://localhost:7687
LOOM_NEO4J_USERNAME=neo4j
LOOM_NEO4J_PASSWORD=
